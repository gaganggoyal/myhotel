# ---------------------------------------------------------------------------
# MyHotel platform configuration. Copy to .env.local and adjust.
# Every value has a working local default; nothing here is required for `npm run dev`.
# ---------------------------------------------------------------------------

# Brand shown on the marketing site, in "Hotel via <Platform>" email names, and in the footer.
PLATFORM_NAME=MyHotel

# Host (and port in development) that serves the marketing site + owner dashboard.
# Hotels get <slug>.<ROOT_DOMAIN>. In development, *.localhost resolves to 127.0.0.1.
ROOT_DOMAIN=localhost:3000
APP_PROTOCOL=http

# Signs form timestamps and other short-lived tokens. Use 32+ random bytes in production.
APP_SECRET=change-me-in-production

# Comma-separated emails that become platform admins when they sign up / log in.
ADMIN_EMAILS=admin@example.com

# Protects /api/cron/run (send as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=dev-cron-secret

# --- Database ---------------------------------------------------------------
# Leave empty to use embedded Postgres (PGlite) stored in .data/pglite.
# In production point this at managed Postgres (Supabase, Neon, RDS...).
DATABASE_URL=

# --- File storage -------------------------------------------------------------
# local (stores in .data/uploads) or s3 (any S3-compatible store: AWS S3, Cloudflare R2, Supabase Storage)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email --------------------------------------------------------------------
# console (dev: stored in the DB, visible in /admin/emails) | resend | postmark
EMAIL_PROVIDER=console
# The authenticated sending subdomain. Publish the provider's DKIM, SPF/return-path and
# a DMARC record (start with p=none and an rua you read) on THIS subdomain only.
MAIL_FROM_DOMAIN=mail.myhotel.example
PLATFORM_FROM_EMAIL=hello@mail.myhotel.example
SUPPORT_EMAIL=support@myhotel.example
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
# Basic-auth credentials you put in the Postmark webhook URL (user:pass)
POSTMARK_WEBHOOK_AUTH=

# --- Custom domains -----------------------------------------------------------
# manual (DNS check + HTTPS probe; TLS handled by your edge) | cloudflare (Cloudflare for SaaS) | vercel
DOMAIN_PROVIDER=manual
# The hostname owners point their CNAME at, e.g. sites.myhotel.in
CNAME_TARGET=sites.myhotel.example
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Platform billing (owner subscriptions) -------------------------------------
# simulated (dev: "Activate" button, no money moves) | razorpay
BILLING_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=

# --- Spam protection (optional) -------------------------------------------------
# Cloudflare Turnstile on public enquiry forms. Honeypot + timing + rate limits always apply.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
